{
  "name": "shiftlane",
  "version": "0.0.0",
  "private": true,
  "description": "SaaS para empresas de transporte de personal en México",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm services:up && pnpm -r --parallel --if-present run dev",
    "services:up": "docker compose -f infra/docker-compose.dev.yml up -d --wait",
    "services:down": "docker compose -f infra/docker-compose.dev.yml down",
    "test": "pnpm docs:verificar && pnpm -r --if-present run test && pnpm test:driver",
    "test:driver": "cd apps/driver && flutter test",
    "lint": "eslint . && prettier --check . && pnpm lint:driver",
    "lint:driver": "cd apps/driver && dart format --output=none --set-exit-if-changed lib test && flutter analyze",
    "format": "prettier --write . && cd apps/driver && dart format lib test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "db:migrate": "pnpm --filter @shiftlane/api run db:migrate",
    "db:seed": "pnpm --filter @shiftlane/api run db:seed",
    "docs:referencia": "python infra/scripts/docx-a-markdown.py",
    "docs:verificar": "python infra/scripts/docx-a-markdown.py --verificar",
    "docs:permisos": "node packages/shared/scripts/actualizar-matriz.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0"
  }
}
