// Esquema de Shiftlane. Tablas y columnas en inglés (snake_case en PostgreSQL).
// La seguridad por filas, los roles y las funciones de contexto viven en las migraciones SQL;
// ver docs/decisiones/0003-multiempresa-y-seguridad-por-filas.md.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Cuentas y acceso
// ---------------------------------------------------------------------------

enum TenantStatus {
  active
  suspended
  cancelled
}

/// Empresa transportista (cuenta del SaaS).
model Tenant {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  legalName String?      @map("legal_name")
  rfc       String?
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(3)

  users               User[]
  permissionOverrides UserPermissionOverride[]
  userRoles           UserRole[]
  sessions            Session[]
  serviceAgreements   ServiceAgreement[]
  createdClientOrgs   ClientOrg[]              @relation("ClientOrgCreatedBy")
  drivers             Driver[]
  driverPins          DriverPin[]
  driverEnrollments   DriverEnrollment[]
  devices             Device[]
  driverDevices       DriverDevice[]
  vehicles            Vehicle[]
  vehicleDocuments    VehicleDocument[]
  driverDocuments     DriverDocument[]
  clientContacts      ClientContact[]
  contracts           Contract[]
  rates               Rate[]
  penalties           Penalty[]
  leads               Lead[]
  plantInvitations    PlantInvitation[]
  shifts              Shift[]
  routes              Route[]
  routeVersions       RouteVersion[]
  stops               Stop[]
  routeStopTimes      RouteStopTime[]
  temporaryChanges    TemporaryChange[]
  routePassengers     RoutePassenger[]

  @@map("tenants")
}

/// Ámbito al que pertenece un usuario: transportista, planta cliente o plataforma.
enum UserKind {
  carrier
  plant
  platform
}

enum UserStatus {
  invited
  active
  disabled
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind         UserKind
  tenantId     String?    @map("tenant_id") @db.Uuid
  clientOrgId  String?    @map("client_org_id") @db.Uuid
  email        String     @unique
  fullName     String     @map("full_name")
  phone        String?
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(active)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)

  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  /// Intentos fallidos seguidos; al llegar al límite la cuenta se bloquea un tiempo.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  /// Secreto TOTP cifrado (AES-256-GCM). La 2FA está activa si totpEnabledAt no es nulo.
  totpSecret        String?   @map("totp_secret")
  totpEnabledAt     DateTime? @map("totp_enabled_at") @db.Timestamptz(3)
  /// Último paso TOTP aceptado, para que un código no se use dos veces.
  totpLastStep      Int?      @map("totp_last_step")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant              Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientOrg           ClientOrg?               @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  roles               UserRole[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  permissionOverrides UserPermissionOverride[]

  @@index([tenantId])
  @@index([clientOrgId])
  @@map("users")
}

/// Ámbito en el que se puede asignar un rol.
enum RoleScope {
  carrier
  plant
  platform
}

/// Catálogo fijo de roles (owner, dispatcher, plant_hr, ...).
model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique
  name        String
  scope       RoleScope
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  /// Copia del ámbito del usuario para que la seguridad por filas no dependa de otra tabla.
  tenantId    String?  @map("tenant_id") @db.Uuid
  clientOrgId String?  @map("client_org_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id])
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientOrg ClientOrg? @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@index([clientOrgId])
  @@map("user_roles")
}

/// Quién inició la sesión.
enum SessionPrincipal {
  user
  driver
  passenger
}

enum PermissionEffect {
  grant
  revoke
}

/// Permiso otorgado o quitado a un usuario además de los de sus roles.
model UserPermissionOverride {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  permission  String
  effect      PermissionEffect
  /// Copia del ámbito del usuario (lo fija un disparador).
  tenantId    String?          @map("tenant_id") @db.Uuid
  clientOrgId String?          @map("client_org_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientOrg ClientOrg? @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([tenantId])
  @@index([clientOrgId])
  @@map("user_permission_overrides")
}

/// Sesión de usuario web, chofer o pasajero: guarda el hash del token de renovación (rotativo).
model Session {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  principal        SessionPrincipal
  userId           String?          @map("user_id") @db.Uuid
  driverId         String?          @map("driver_id") @db.Uuid
  passengerId      String?          @map("passenger_id") @db.Uuid
  deviceId         String?          @map("device_id") @db.Uuid
  tenantId         String?          @map("tenant_id") @db.Uuid
  clientOrgId      String?          @map("client_org_id") @db.Uuid
  /// Todas las rotaciones de un mismo inicio de sesión comparten familia.
  familyId         String           @map("family_id") @db.Uuid
  refreshTokenHash String           @unique @map("refresh_token_hash")
  userAgent        String?          @map("user_agent")
  ip               String?
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime?        @map("rotated_at") @db.Timestamptz(3)
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver    Driver?    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  passenger Passenger? @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  device    Device?    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientOrg ClientOrg? @relation(fields: [clientOrgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([driverId])
  @@index([passengerId])
  @@index([familyId])
  @@map("sessions")
}

/// Token de un solo uso para restablecer la contraseña (solo se guarda su hash).
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Bitácora inmutable de cambios (quién, qué, antes y después).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?  @map("tenant_id") @db.Uuid
  clientOrgId String?  @map("client_org_id") @db.Uuid
  /// user, driver, passenger o system.
  actorType   String   @default("system") @map("actor_type")
  actorId     String?  @map("actor_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  requestId   String?  @map("request_id")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([clientOrgId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Clientes: empresas cliente, plantas y acuerdos de servicio
// ---------------------------------------------------------------------------

/// Empresa cliente (maquila). Es compartida: puede trabajar con varias transportistas.
model ClientOrg {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  legalName         String?   @map("legal_name")
  rfc               String?
  /// Transportista que la registró. Puede administrarla mientras no tenga usuarios propios.
  createdByTenantId String?   @map("created_by_tenant_id") @db.Uuid
  /// Fecha en que la empresa cliente activó sus propios usuarios.
  claimedAt         DateTime? @map("claimed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  createdByTenant      Tenant?                  @relation("ClientOrgCreatedBy", fields: [createdByTenantId], references: [id], onDelete: Restrict)
  plants               Plant[]
  users                User[]
  permissionOverrides  UserPermissionOverride[]
  userRoles            UserRole[]
  sessions             Session[]
  serviceAgreements    ServiceAgreement[]
  passengers           Passenger[]
  gates                PlantGate[]
  contacts             ClientContact[]
  contracts            Contract[]
  invitations          PlantInvitation[]
  passengerCredentials PassengerCredential[]
  provisionalBadges    ProvisionalBadge[]
  passengerImports     PassengerImport[]

  @@index([createdByTenantId])
  @@map("client_orgs")
}

model Plant {
  id                      String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientOrgId             String                                 @map("client_org_id") @db.Uuid
  name                    String
  address                 String?
  /// Ubicación de la planta (PostGIS). Se lee y escribe con SQL.
  location                Unsupported("geography(Point, 4326)")?
  timezone                String                                 @default("America/Ciudad_Juarez")
  /// Código que la planta comparte con sus empleados para activar la app del pasajero.
  passengerActivationCode String?                                @unique @map("passenger_activation_code")
  createdAt               DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?                              @map("deleted_at") @db.Timestamptz(3)

  clientOrg         ClientOrg          @relation(fields: [clientOrgId], references: [id])
  serviceAgreements ServiceAgreement[]
  passengers        Passenger[]
  gates             PlantGate[]
  contacts          ClientContact[]
  contracts         Contract[]
  invitations       PlantInvitation[]
  provisionalBadges ProvisionalBadge[]
  passengerImports  PassengerImport[]
  shifts            Shift[]
  routes            Route[]

  @@unique([id, clientOrgId])
  @@index([clientOrgId])
  @@map("plants")
}

enum ServiceAgreementStatus {
  pending
  active
  suspended
  ended
}

/// Acuerdo con el que una transportista da servicio a una planta. Es la única vía por la que
/// una planta ve datos de la transportista.
model ServiceAgreement {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  clientOrgId String                 @map("client_org_id") @db.Uuid
  plantId     String                 @map("plant_id") @db.Uuid
  status      ServiceAgreementStatus @default(active)
  startsOn    DateTime?              @map("starts_on") @db.Date
  endsOn      DateTime?              @map("ends_on") @db.Date
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id])
  plant     Plant     @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId])

  @@unique([tenantId, plantId])
  @@index([clientOrgId])
  @@index([plantId])
  @@map("service_agreements")
}

// ---------------------------------------------------------------------------
// Choferes y celulares (acceso a la app del chofer). F02-P01 completa el catálogo.
// ---------------------------------------------------------------------------

enum DriverStatus {
  active
  inactive
}

model Driver {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  fullName              String       @map("full_name")
  employeeNumber        String?      @map("employee_number")
  phone                 String?
  status                DriverStatus @default(active)
  licenseNumber         String?      @map("license_number")
  /// Tipo de licencia según la entidad (por ejemplo, "C" o "Federal B").
  licenseType           String?      @map("license_type")
  emergencyContactName  String?      @map("emergency_contact_name")
  emergencyContactPhone String?      @map("emergency_contact_phone")
  habitualVehicleId     String?      @map("habitual_vehicle_id") @db.Uuid
  photoKey              String?      @map("photo_key")
  notes                 String?
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?    @map("deleted_at") @db.Timestamptz(3)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  habitualVehicle Vehicle?           @relation(fields: [habitualVehicleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  pin             DriverPin?
  enrollments     DriverEnrollment[]
  devices         DriverDevice[]
  sessions        Session[]
  documents       DriverDocument[]

  @@unique([id, tenantId])
  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@map("drivers")
}

/// PIN de 4 dígitos del chofer (hash argon2id). Sin pinHash, el chofer debe crear uno nuevo.
model DriverPin {
  driverId       String    @id @map("driver_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  pinHash        String?   @map("pin_hash")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([driverId, tenantId])
  @@index([tenantId])
  @@map("driver_pins")
}

/// Código QR de un solo uso para vincular a un chofer con un celular.
model DriverEnrollment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  driverId        String    @map("driver_id") @db.Uuid
  codeHash        String    @unique @map("code_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([driverId])
  @@map("driver_enrollments")
}

/// Celular registrado. Se autentica con un secreto que solo conoce la app (se guarda su hash).
model Device {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  secretHash String    @map("secret_hash")
  platform   String?
  model      String?
  appVersion String?   @map("app_version")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  drivers  DriverDevice[]
  sessions Session[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("devices")
}

/// Choferes vinculados a un celular (un celular puede ser compartido entre turnos).
model DriverDevice {
  driverId   String    @map("driver_id") @db.Uuid
  deviceId   String    @map("device_id") @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  enrolledAt DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  driver Driver @relation(fields: [driverId, tenantId], references: [id, tenantId], onDelete: Cascade)
  device Device @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([driverId, deviceId])
  @@index([tenantId])
  @@index([deviceId])
  @@map("driver_devices")
}

// ---------------------------------------------------------------------------
// Pasajeros (lista de empleados de la planta). F02-P03 completa el catálogo.
// ---------------------------------------------------------------------------

enum PassengerStatus {
  active
  inactive
}

model Passenger {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientOrgId    String          @map("client_org_id") @db.Uuid
  plantId        String          @map("plant_id") @db.Uuid
  employeeNumber String          @map("employee_number")
  fullName       String          @map("full_name")
  status         PassengerStatus @default(active)
  shiftName      String?         @map("shift_name")
  phone          String?
  activatedAt    DateTime?       @map("activated_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz(3)

  clientOrg        ClientOrg             @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  plant            Plant                 @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId], onDelete: Restrict)
  sessions         Session[]
  credentials      PassengerCredential[]
  resolvedBadges   ProvisionalBadge[]
  routeAssignments RoutePassenger[]

  @@unique([clientOrgId, employeeNumber])
  @@index([plantId])
  @@map("passengers")
}

// ---------------------------------------------------------------------------
// Unidades y documentos (catálogos de flota)
// ---------------------------------------------------------------------------

enum VehicleStatus {
  available
  on_route
  maintenance
  out_of_service
}

model Vehicle {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  /// Número económico: identificador interno de la unidad en la transportista.
  economicNumber String        @map("economic_number")
  plates         String
  make           String?
  model          String
  year           Int
  /// Asientos para pasajeros.
  capacity       Int
  status         VehicleStatus @default(available)
  odometerKm     Int           @default(0) @map("odometer_km")
  photoKey       String?       @map("photo_key")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(3)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents       VehicleDocument[]
  habitualDrivers Driver[]

  @@unique([id, tenantId])
  @@unique([tenantId, economicNumber])
  @@unique([tenantId, plates])
  @@index([tenantId, status])
  @@map("vehicles")
}

enum VehicleDocumentType {
  permit
  insurance
  registration_card
  emissions_verification
  other
}

model VehicleDocument {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  vehicleId String              @map("vehicle_id") @db.Uuid
  type      VehicleDocumentType
  number    String?
  issuedOn  DateTime?           @map("issued_on") @db.Date
  expiresOn DateTime?           @map("expires_on") @db.Date
  fileKey   String?             @map("file_key")
  fileName  String?             @map("file_name")
  fileType  String?             @map("file_type")
  notes     String?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?           @map("deleted_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@index([vehicleId])
  @@map("vehicle_documents")
}

enum DriverDocumentType {
  license
  medical_exam
  drug_test
  training
  other
}

model DriverDocument {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  driverId  String             @map("driver_id") @db.Uuid
  type      DriverDocumentType
  number    String?
  issuedOn  DateTime?          @map("issued_on") @db.Date
  expiresOn DateTime?          @map("expires_on") @db.Date
  fileKey   String?            @map("file_key")
  fileName  String?            @map("file_name")
  fileType  String?            @map("file_type")
  notes     String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  driver Driver @relation(fields: [driverId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@index([driverId])
  @@map("driver_documents")
}

// ---------------------------------------------------------------------------
// CRM: puertas, contactos, contratos, tarifas, penalizaciones y prospectos
// ---------------------------------------------------------------------------

/// Puerta de acceso de la planta. Su QR fijo prueba que la unidad llegó (lo escanea el chofer).
model PlantGate {
  id          String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientOrgId String                                 @map("client_org_id") @db.Uuid
  plantId     String                                 @map("plant_id") @db.Uuid
  name        String
  qrCode      String                                 @unique @map("qr_code")
  location    Unsupported("geography(Point, 4326)")?
  active      Boolean                                @default(true)
  createdAt   DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?                              @map("deleted_at") @db.Timestamptz(3)

  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  plant     Plant     @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId], onDelete: Restrict)

  @@index([plantId])
  @@map("plant_gates")
}

enum ContactArea {
  logistics
  hr
  security
  purchasing
  finance
  management
  other
}

/// Contacto de una empresa cliente en el CRM de la transportista.
model ClientContact {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  clientOrgId String      @map("client_org_id") @db.Uuid
  plantId     String?     @map("plant_id") @db.Uuid
  fullName    String      @map("full_name")
  area        ContactArea @default(other)
  position    String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  plant     Plant?    @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId], onDelete: Restrict)

  @@index([tenantId, clientOrgId])
  @@map("client_contacts")
}

enum ContractStatus {
  draft
  active
  ended
}

/// Contrato de servicio entre la transportista y una empresa cliente.
model Contract {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  clientOrgId String         @map("client_org_id") @db.Uuid
  /// Planta a la que aplica; nulo = todas las plantas atendidas de la empresa.
  plantId     String?        @map("plant_id") @db.Uuid
  name        String
  number      String?
  status      ContractStatus @default(draft)
  startsOn    DateTime       @map("starts_on") @db.Date
  endsOn      DateTime?      @map("ends_on") @db.Date
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  plant     Plant?    @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId], onDelete: Restrict)
  rates     Rate[]
  penalties Penalty[]

  @@unique([id, tenantId])
  @@index([tenantId, clientOrgId])
  @@map("contracts")
}

enum RateBasis {
  per_trip
  per_route
  per_km
  per_vehicle
  per_passenger
}

/// Tarifa de un contrato; las condiciones (días, horario, ruta, capacidad) la hacen especial.
model Rate {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  contractId    String    @map("contract_id") @db.Uuid
  name          String?
  basis         RateBasis
  amount        Decimal   @db.Decimal(12, 2)
  /// Ruta a la que aplica (la tabla de rutas llega en F03).
  routeId       String?   @map("route_id") @db.Uuid
  weekdays      Int[]     @default([])
  startTime     String?   @map("start_time")
  endTime       String?   @map("end_time")
  holidays      Boolean?
  minCapacity   Int?      @map("min_capacity")
  maxCapacity   Int?      @map("max_capacity")
  validFrom     DateTime? @map("valid_from") @db.Date
  validTo       DateTime? @map("valid_to") @db.Date
  minimumCharge Decimal?  @map("minimum_charge") @db.Decimal(12, 2)
  priority      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Cascade)
  route    Route?   @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([contractId])
  @@map("rates")
}

enum PenaltyType {
  late_arrival
  missed_trip
  incomplete_trip
  other
}

enum PenaltyAmountType {
  fixed
  percent
}

model Penalty {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  contractId   String            @map("contract_id") @db.Uuid
  type         PenaltyType
  description  String?
  amountType   PenaltyAmountType @map("amount_type")
  amount       Decimal           @db.Decimal(12, 2)
  graceMinutes Int?              @map("grace_minutes")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  contract Contract @relation(fields: [contractId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([contractId])
  @@map("penalties")
}

enum LeadStage {
  contacted
  quoted
  pilot
  won
  lost
}

/// Prospecto en el CRM de la transportista.
model Lead {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  companyName           String    @map("company_name")
  contactName           String?   @map("contact_name")
  email                 String?
  phone                 String?
  stage                 LeadStage @default(contacted)
  estimatedVehicles     Int?      @map("estimated_vehicles")
  estimatedMonthlyValue Decimal?  @map("estimated_monthly_value") @db.Decimal(12, 2)
  lostReason            String?   @map("lost_reason")
  notes                 String?
  convertedClientOrgId  String?   @map("converted_client_org_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, stage])
  @@map("leads")
}

/// Invitación por correo a un usuario de planta. Al aceptarla, la empresa cliente queda con
/// usuarios propios y el acuerdo de servicio activo.
model PlantInvitation {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  clientOrgId     String    @map("client_org_id") @db.Uuid
  plantId         String    @map("plant_id") @db.Uuid
  email           String
  fullName        String    @map("full_name")
  roleKey         String    @map("role_key")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  acceptedUserId  String?   @map("accepted_user_id") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  plant     Plant     @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId], onDelete: Restrict)

  @@index([tenantId])
  @@index([plantId])
  @@map("plant_invitations")
}

// ---------------------------------------------------------------------------
// Credenciales de pasajeros, gafetes provisionales y cargas de Excel
// ---------------------------------------------------------------------------

enum CredentialKind {
  /// QR firmado por Shiftlane (se muestra en la app del pasajero).
  shiftlane_qr
  /// Gafete existente de la planta con código de barras.
  badge_barcode
  /// Gafete existente de la planta con QR propio.
  badge_qr
}

model PassengerCredential {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientOrgId String         @map("client_org_id") @db.Uuid
  passengerId String         @map("passenger_id") @db.Uuid
  kind        CredentialKind
  /// Código del gafete, o identificador aleatorio de la credencial de Shiftlane.
  value       String
  issuedAt    DateTime       @default(now()) @map("issued_at") @db.Timestamptz(3)
  revokedAt   DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([clientOrgId, kind, value])
  @@index([passengerId])
  @@map("passenger_credentials")
}

enum BadgeKind {
  barcode
  qr
}

enum ProvisionalBadgeStatus {
  pending
  resolved
  dismissed
}

/// Gafete que el chofer escaneó y no está en la lista de la planta. No detiene el viaje;
/// RH lo resuelve después asignándolo a un empleado o descartándolo.
model ProvisionalBadge {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientOrgId         String                 @map("client_org_id") @db.Uuid
  plantId             String                 @map("plant_id") @db.Uuid
  /// Transportista cuyo chofer lo escaneó por primera vez.
  tenantId            String?                @map("tenant_id") @db.Uuid
  value               String
  kind                BadgeKind
  status              ProvisionalBadgeStatus @default(pending)
  seenCount           Int                    @default(1) @map("seen_count")
  firstSeenAt         DateTime               @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt          DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  resolvedPassengerId String?                @map("resolved_passenger_id") @db.Uuid
  resolvedByUserId    String?                @map("resolved_by_user_id") @db.Uuid
  resolvedAt          DateTime?              @map("resolved_at") @db.Timestamptz(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  clientOrg         ClientOrg  @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  plant             Plant      @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId], onDelete: Restrict)
  resolvedPassenger Passenger? @relation(fields: [resolvedPassengerId], references: [id], onDelete: SetNull)

  @@unique([clientOrgId, value])
  @@index([plantId, status])
  @@map("provisional_badges")
}

enum PassengerImportMode {
  /// Solo las filas del archivo: altas, cambios y bajas marcadas.
  changes
  /// El archivo es la lista completa: quien no aparece se da de baja.
  full
}

enum PassengerImportStatus {
  previewed
  applied
  discarded
}

/// Carga de Excel de empleados: primero vista previa de diferencias, luego se aplica.
model PassengerImport {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientOrgId      String                @map("client_org_id") @db.Uuid
  plantId          String                @map("plant_id") @db.Uuid
  uploadedByUserId String?               @map("uploaded_by_user_id") @db.Uuid
  fileName         String                @map("file_name")
  mode             PassengerImportMode
  status           PassengerImportStatus @default(previewed)
  /// Filas validadas del archivo; se borran al aplicar para no guardar datos de más.
  rows             Json?
  summary          Json
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  appliedAt        DateTime?             @map("applied_at") @db.Timestamptz(3)

  clientOrg ClientOrg @relation(fields: [clientOrgId], references: [id], onDelete: Restrict)
  plant     Plant     @relation(fields: [plantId, clientOrgId], references: [id, clientOrgId], onDelete: Restrict)

  @@index([clientOrgId, createdAt])
  @@map("passenger_imports")
}

// ---------------------------------------------------------------------------
// Turnos y rutas
// ---------------------------------------------------------------------------

/// Turno de una planta atendida por la transportista (F04 agrega calendario y días).
model Shift {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  plantId   String    @map("plant_id") @db.Uuid
  name      String
  /// Hora de entrada a planta HH:MM.
  startsAt  String    @map("starts_at")
  /// Hora de salida de planta HH:MM.
  endsAt    String    @map("ends_at")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plant  Plant   @relation(fields: [plantId], references: [id], onDelete: Restrict)
  routes Route[]

  @@unique([id, tenantId])
  @@unique([tenantId, plantId, name])
  @@map("shifts")
}

enum RouteDirection {
  /// Hacia la planta (entrada al turno).
  inbound
  /// Desde la planta (salida del turno).
  outbound
}

model Route {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  plantId   String         @map("plant_id") @db.Uuid
  shiftId   String?        @map("shift_id") @db.Uuid
  code      String
  name      String
  direction RouteDirection
  active    Boolean        @default(true)
  notes     String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plant            Plant             @relation(fields: [plantId], references: [id], onDelete: Restrict)
  shift            Shift?            @relation(fields: [shiftId, tenantId], references: [id, tenantId], onDelete: Restrict)
  versions         RouteVersion[]
  temporaryChanges TemporaryChange[]
  rates            Rate[]
  passengers       RoutePassenger[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, plantId])
  @@map("routes")
}

enum RouteVersionKind {
  regular
  temporary
}

/// Versión de una ruta (paradas, horarios y trazo). Las regulares aplican desde valid_from
/// hasta que empieza otra; las temporales solo dentro de su cambio temporal.
model RouteVersion {
  id              String                                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                                      @map("tenant_id") @db.Uuid
  routeId         String                                      @map("route_id") @db.Uuid
  number          Int
  kind            RouteVersionKind                            @default(regular)
  validFrom       DateTime                                    @map("valid_from") @db.Date
  path            Unsupported("geography(LineString, 4326)")?
  distanceKm      Decimal?                                    @map("distance_km") @db.Decimal(8, 2)
  durationMinutes Int?                                        @map("duration_minutes")
  /// Origen del cálculo de distancia y tiempo: osrm, straight_line o manual (trazo dibujado).
  routingSource   String?                                     @map("routing_source")
  notes           String?
  /// Versión de la que se copió (al restaurar o derivar).
  basedOnId       String?                                     @map("based_on_id") @db.Uuid
  createdByUserId String?                                     @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                                    @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime?                                   @map("deleted_at") @db.Timestamptz(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  route            Route             @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  stops            Stop[]
  temporaryChanges TemporaryChange[]

  @@unique([id, tenantId])
  @@unique([routeId, number])
  @@index([routeId, validFrom])
  @@map("route_versions")
}

/// Parada de una versión de ruta. stop_key se conserva entre versiones de la misma parada.
model Stop {
  id             String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                                @map("tenant_id") @db.Uuid
  routeVersionId String                                @map("route_version_id") @db.Uuid
  stopKey        String                                @default(dbgenerated("gen_random_uuid()")) @map("stop_key") @db.Uuid
  sequence       Int
  name           String
  address        String?
  location       Unsupported("geography(Point, 4326)")
  /// Radio de la geocerca para detectar la llegada (metros).
  radiusMeters   Int                                   @default(80) @map("radius_meters")
  notes          String?

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  routeVersion RouteVersion    @relation(fields: [routeVersionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  times        RouteStopTime[]

  @@unique([id, tenantId])
  @@unique([routeVersionId, sequence])
  @@index([routeVersionId])
  @@map("stops")
}

/// Horario programado de una parada; puede variar por día de la semana.
model RouteStopTime {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  stopId   String @map("stop_id") @db.Uuid
  /// Días de la semana (0 = domingo). Vacío = todos los días.
  weekdays Int[]  @default([])
  /// HH:MM
  time     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stop   Stop   @relation(fields: [stopId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([stopId])
  @@map("route_stop_times")
}

/// Cambio de ruta entre dos fechas; al terminar vuelve sola la versión normal (F03-P03).
model TemporaryChange {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  routeId         String    @map("route_id") @db.Uuid
  /// Versión alterna (paradas u horarios distintos); nula si el cambio suspende el servicio.
  routeVersionId  String?   @map("route_version_id") @db.Uuid
  suspendsService Boolean   @default(false) @map("suspends_service")
  startsOn        DateTime  @map("starts_on") @db.Date
  endsOn          DateTime  @map("ends_on") @db.Date
  reason          String
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  route        Route         @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  routeVersion RouteVersion? @relation(fields: [routeVersionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([routeId, startsOn])
  @@map("temporary_changes")
}

/// Caché de cálculos de rutas por calles (solo la usa el sistema).
model RoutingCache {
  key       String   @id
  result    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("routing_cache")
}

/// Pasajero asignado a una parada de la ruta (por stop_key, estable entre versiones).
model RoutePassenger {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  routeId     String    @map("route_id") @db.Uuid
  passengerId String    @map("passenger_id") @db.Uuid
  stopKey     String    @map("stop_key") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  route     Route     @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  passenger Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)

  @@unique([routeId, passengerId])
  @@index([passengerId])
  @@map("route_passengers")
}
