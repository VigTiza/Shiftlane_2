    "pg": "catalog:",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "^7.2.1",
