# Variables de entorno de apps/api. Copia este archivo a .env y completa los valores.
# Se agregan en la fase que las necesite. Nunca pongas secretos reales en este archivo.

# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Activar (true) cuando la API esté detrás de un proxy como Caddy o Cloudflare.
TRUST_PROXY=false
# Documentación OpenAPI interactiva en /docs.
API_DOCS_ENABLED=true

# Orígenes permitidos para CORS, separados por comas.
CORS_ORIGINS=http://localhost:5173

# Límite de peticiones por IP en la ventana indicada.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Base de datos (PostgreSQL 16 + PostGIS de infra/docker-compose.dev.yml)
DATABASE_URL=postgresql://shiftlane:shiftlane@localhost:5432/shiftlane

# Autenticación. Genera valores propios, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (JWT_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (ENCRYPTION_KEY)
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
ENCRYPTION_KEY=cambia-este-valor-por-32-bytes-en-base64=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DRIVER_REFRESH_TOKEN_TTL_DAYS=90
PASSENGER_REFRESH_TOKEN_TTL_DAYS=180
# Cookie solo por HTTPS (por omisión, activa en producción).
# COOKIE_SECURE=true
# Peticiones por minuto e IP en inicio de sesión y activación.
AUTH_RATE_LIMIT_MAX=10

# Llave Ed25519 para firmar credenciales QR de pasajeros (PKCS8 DER en base64). Genera una con:
#   node -e "const c=require('crypto');console.log(c.generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
CREDENTIAL_SIGNING_KEY=cambia-este-valor

# Correo: Mailpit de infra/docker-compose.dev.yml (interfaz en http://localhost:8025).
APP_URL=http://localhost:5173
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Shiftlane <no-responder@shiftlane.mx>

# Archivos: carpeta local (por omisión) o S3/R2/MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Con MinIO de infra/docker-compose.dev.yml:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=shiftlane
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=shiftlane
# S3_SECRET_ACCESS_KEY=shiftlane-dev
# S3_FORCE_PATH_STYLE=true
# Prueba del adaptador S3 contra MinIO (opcional):
# S3_TEST_ENDPOINT=http://localhost:9000

# Rutas por calles. Con OSRM propio (recomendado en producción, extracto de México):
# ROUTING_PROVIDER=osrm
# ROUTING_URL=http://localhost:5000
ROUTING_PROVIDER=straight_line
ROUTING_TIMEOUT_MS=4000
ROUTING_AVERAGE_SPEED_KMH=28
OFF_ROUTE_THRESHOLD_METERS=150

# Zona horaria por omisión para fechas de negocio.
DEFAULT_TIME_ZONE=America/Ciudad_Juarez

# --- Tareas programadas ---
# Generación diaria de viajes (por omisión activa salvo con NODE_ENV=test).
SCHEDULER_ENABLED=true
# Hora local a la que corren las tareas diarias (0-23).
DAILY_JOBS_HOUR=2
# Días de viajes generados por adelantado.
TRIP_HORIZON_DAYS=14

# --- Posiciones GPS ---
# Redis para posiciones en vivo (con Docker: pnpm services:up). Sin REDIS_URL se usa memoria.
REDIS_URL=redis://localhost:6379
LIVE_POSITION_TTL_SECONDS=600
# Días por adelantado con partición del historial GPS.
POSITION_PARTITION_DAYS_AHEAD=7
# Versión mínima de la app del chofer (con una menor no puede iniciar viajes).
# MIN_DRIVER_APP_VERSION=1.0.0

# Pruebas de Redis (se omiten si no está definida; en CI usan un contenedor).
# REDIS_TEST_URL=redis://localhost:6379

# Datos de ejemplo: contraseña para los usuarios de prisma/seed.ts (solo desarrollo).
# SEED_USER_PASSWORD=

# Pruebas: conexión con permiso para crear bases; cada corrida crea y borra una base temporal.
# Si no se define, las pruebas levantan PostgreSQL con Testcontainers (requiere Docker).
# TEST_DATABASE_URL=postgresql://shiftlane:shiftlane@localhost:5432/postgres
