{
  "name": "@shiftlane/api",
  "version": "0.0.0",
  "private": true,
  "description": "API y servicios automáticos de Shiftlane",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@shiftlane/shared": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "pg": "catalog:",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "catalog:",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
